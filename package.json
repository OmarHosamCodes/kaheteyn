{
  "name": "kaheteyn",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "next-themes": "^0.4.6",
      "postgres": "^3.4.7",
      "@trpc/server": "^11.16.0",
      "@trpc/client": "^11.16.0",
      "better-auth": "1.6.9",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "build": "nx run-many -t build",
    "start": "bun run apps/web/server.ts",
    "check-types": "nx run-many -t check-types",
    "dev:web": "nx run-many -t dev --projects=web",
    "db:push": "nx run-many -t db:push --projects=@kaheteyn/db",
    "db:studio": "nx run-many -t db:studio --projects=@kaheteyn/db",
    "db:generate": "nx run-many -t db:generate --projects=@kaheteyn/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@kaheteyn/db",
    "seed": "bun --env-file=../../apps/web/.env run --cwd packages/db ../../scripts/seed.ts",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@kaheteyn/auth": "workspace:*",
    "@kaheteyn/db": "workspace:*",
    "@kaheteyn/env": "workspace:*",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@kaheteyn/config": "workspace:*",
    "@types/node": "catalog:",
    "nx": "^21.5.2",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.12"
}
